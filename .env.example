# ─────────────────────────────────────────────────────────────
#  OpsTracking — environment template
#
#  cp .env.example .env   &&   chmod 600 .env
#  NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Which settings module to load. dev | prod
DJANGO_SETTINGS_MODULE=opstracking.settings.dev

# 50+ random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-insecure-key-change-me-before-any-deployment

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ─── Database ────────────────────────────────────────────────
# PostgreSQL for local dev (docker compose up -d brings this up).
DATABASE_URL=postgres://opstracking:opstracking@127.0.0.1:5432/opstracking

# Production against the legacy MySQL schema instead:
# DATABASE_URL=mysql://opsuser_app:PASSWORD@127.0.0.1:3306/opsuser_opstracking

# Legacy tables (ot_users, ot_user_work_data, aps_Break_Times, …).
#   True  → Django owns them; migrations create them. Use locally.
#   False → Django reads/writes but never alters them. Use in production
#           where the tables already exist and the Flask app may still run.
LEGACY_TABLES_MANAGED=True

# ─── Redis ───────────────────────────────────────────────────
# Channels layer (db 0), Celery broker (db 1), results (db 2), cache (db 3).
REDIS_URL=redis://127.0.0.1:6379

# ─── Storage ─────────────────────────────────────────────────
# MUST live outside the web root in production.
# For a local folder: PRIVATE_STORAGE_ROOT=./storage
# For a Windows LAN Network shared folder: PRIVATE_STORAGE_ROOT=\\192.168.1.100\SharedDrive\opstracking
PRIVATE_STORAGE_ROOT=./storage

# If using a Windows LAN Network drive, set these to "None" to prevent 
# Django from crashing when trying to change Linux-style permissions on the share.
FILE_UPLOAD_PERMISSIONS=0o640
FILE_UPLOAD_DIRECTORY_PERMISSIONS=0o750
STATIC_ROOT=./staticfiles

# ─── Realtime ────────────────────────────────────────────────
# Public websocket origin. Empty = same origin as the page.
WS_PUBLIC_URL=

# ─── Email ───────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=opstracking@example.com

# ─── Observability (optional) ────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO

# ─── Feature flags ───────────────────────────────────────────
# Chat is scaffolded but not implemented — see apps/chat/README.md.
FEATURE_CHAT=False
FEATURE_PRESENCE=True
FEATURE_NOTIFICATIONS=True
